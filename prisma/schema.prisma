generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id              String       @id @default(cuid())
  /// Puede faltar: una empresa con solo teléfono recibe los pasos de WhatsApp y las tareas.
  email           String?      @unique
  firstName       String?
  lastName        String?
  company         String?
  title           String?
  phone           String?
  /// WhatsApp, si es distinto del teléfono.
  whatsapp        String?
  city            String?
  province        String?
  website         String?
  /// Empresa del Radar comercial de la que salió este contacto (una sola por empresa: lo cuida el código).
  /// Índice común y no único a propósito: agregar un único a una tabla que ya existe frena `prisma db push` en Vercel.
  radarId         String?
  tags            String[]
  unsubscribed    Boolean      @default(false)
  bounced         Boolean      @default(false)
  /// Verificador de correos: valido, riesgoso, corregible o invalido (vacío = sin verificar).
  emailStatus     String?
  emailReason     String?
  emailSuggestion String?
  emailCheckedAt  DateTime?
  /// Vendedor dueño del cliente: el que lo buscó, lo cargó o le escribió primero. Los demás no le pueden escribir.
  /// Vacío = libre (cualquiera lo puede tomar).
  ownerId         String?
  owner           Sender?      @relation("ClientesDe", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerAt         DateTime?
  /// Sección del vendedor donde quedó, con la zona de la búsqueda que lo trajo (ej. «Córdoba – Luis Mendieta»).
  seccion         String?
  createdAt       DateTime     @default(now())
  enrollments     Enrollment[]
  replies         Reply[]

  @@index([radarId])
  @@index([ownerId])
}

enum SequenceStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

model Sequence {
  id          String         @id @default(cuid())
  name        String
  status      SequenceStatus @default(DRAFT)
  dailyLimit  Int            @default(50)
  senderId    String?
  sender      Sender?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  /// Interruptor de la secuencia: apagado al crearla; solo envía si está encendido.
  sendingOn   Boolean        @default(false)
  /// Horario de envío propio: zona, horas [inicio, fin) y días (0 = domingo … 6 = sábado).
  timeZone    String         @default("America/Argentina/Buenos_Aires")
  startHour   Int            @default(8)
  endHour     Int            @default(19)
  sendDays    Int[]          @default([1, 2, 3, 4, 5])
  /// Solo texto: sin HTML, sin píxel de apertura y con la firma en texto (llega mejor a la bandeja principal).
  plainText   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  steps       Step[]
  enrollments Enrollment[]
}

enum StepType {
  EMAIL
  TASK
  /// Mensaje de WhatsApp: el programador crea una tarea con el mensaje listo para abrir en WhatsApp.
  WHATSAPP
}

model Step {
  id         String        @id @default(cuid())
  sequenceId String
  sequence   Sequence      @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order      Int
  type       StepType      @default(EMAIL)
  delayDays  Int           @default(0)
  subject    String        @default("")
  body       String        @default("")
  sameThread Boolean       @default(true)
  /// WhatsApp automático: nombre de la plantilla aprobada por Meta. Vacío = queda como tarea con el mensaje listo.
  waTemplate String        @default("")
  /// Idioma de la plantilla tal como figura en Meta (es_AR, es…).
  waLang     String        @default("es_AR")
  /// Qué va en cada {{1}}, {{2}}… de la plantilla, separado por comas: variables de la app como {{nombre}} o {{mi_nombre}}.
  waParams   String        @default("")
  messages   Message[]
  /// Variantes B, C… del email (la A es el asunto y el cuerpo del propio paso).
  variants   StepVariant[]

  @@unique([sequenceId, order])
}

model StepVariant {
  id        String   @id @default(cuid())
  stepId    String
  step      Step     @relation(fields: [stepId], references: [id], onDelete: Cascade)
  label     String
  subject   String   @default("")
  body      String   @default("")
  createdAt DateTime @default(now())

  @@unique([stepId, label])
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  REPLIED
  FINISHED
  BOUNCED
  UNSUBSCRIBED
}

model Enrollment {
  id         String           @id @default(cuid())
  sequenceId String
  sequence   Sequence         @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status     EnrollmentStatus @default(ACTIVE)
  nextStep   Int              @default(1)
  nextRunAt  DateTime?        @default(now())
  createdAt  DateTime         @default(now())
  /// Cuándo terminó la secuencia: una semana después, otro remitente puede volver a escribirle.
  finishedAt DateTime?
  messages   Message[]
  tasks      Task[]
  waMessages WaMessage[]

  @@unique([sequenceId, contactId])
  @@index([status, nextRunAt])
}

model Message {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId       String
  step         Step       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  messageId    String     @unique
  subject      String
  sentAt       DateTime   @default(now())
  openedAt     DateTime?
  openCount    Int        @default(0)
  error        String?
  /// Buzón que lo envió; sirve para contar el cupo diario de cada remitente.
  fromEmail    String     @default("")
  /// Variante del paso que se envió (A, B, C…).
  variant      String     @default("A")
  /// true = salió como respuesta en el mismo hilo (Re:); false = correo nuevo. Vacío en los envíos de antes de guardarlo.
  threaded     Boolean?
}

/// WhatsApp enviado solo por la API oficial (Meta): uno por paso y contacto.
model WaMessage {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId       String
  senderId     String?
  to           String
  template     String
  /// Id que devuelve Meta (wamid…); vacío si falló.
  wamid        String?
  error        String?
  sentAt       DateTime   @default(now())

  @@index([senderId, sentAt])
}

/// Conversación por WhatsApp en el número de la API: lo que escribe el cliente, lo que contesta el bot y lo que contesta una persona desde Dartpac.
model WaChat {
  id            String   @id @default(cuid())
  /// Número del cliente (como lo manda Meta: 549…).
  waId          String
  /// Número de la empresa que recibió o mandó el mensaje (ID de Meta).
  phoneNumberId String
  /// Nombre que el cliente tiene en su WhatsApp.
  name          String   @default("")
  /// in = escribió el cliente; out = salió de la empresa.
  direction     String
  /// cliente, bot o persona.
  by            String
  body          String
  /// Id de Meta (wamid…): evita guardar dos veces el mismo mensaje si Meta lo reenvía.
  wamid         String?  @unique
  contactId     String?
  error         String?
  at            DateTime @default(now())

  @@index([waId, at])
}

model Task {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  /// TASK (llamada, visita…) o WHATSAPP (las notas son el mensaje listo para mandar).
  kind         String     @default("TASK")
  title        String
  notes        String     @default("")
  done         Boolean    @default(false)
  createdAt    DateTime   @default(now())
}

enum ReplyLabel {
  NEW
  INTERESTED
  MEETING
  LATER
  NOT_INTERESTED
}

model Reply {
  id         String     @id @default(cuid())
  contactId  String
  contact    Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messageId  String     @unique
  inReplyTo  String?
  subject    String
  body       String
  receivedAt DateTime
  read       Boolean    @default(false)
  label      ReplyLabel @default(NEW)
  /// Buzón donde llegó la respuesta.
  mailbox    String     @default("")
}

/// Comercial que envía: cada secuencia sale de su buzón y lleva su firma.
model Sender {
  id                    String     @id @default(cuid())
  name                  String
  email                 String     @unique
  /// Contraseña de aplicación de Gmail, cifrada con ENCRYPTION_KEY.
  appPassword           String?
  /// Conexión con Google (OAuth): refresh token cifrado. Si existe, se usa en lugar de la contraseña.
  googleRefreshToken    String?
  googleConnectedAt     DateTime?
  signature             String     @default("")
  /// Datos de la firma profesional (se muestran en HTML; `signature` queda como texto extra).
  jobTitle              String     @default("")
  phone                 String     @default("")
  website               String     @default("")
  /// WhatsApp del remitente: el Radar lo muestra al escribirle a un contacto y lo pone en la firma del mensaje.
  whatsapp              String     @default("")
  /// ID del número en la API oficial de WhatsApp (Meta, «Phone number ID»). Vacío = sin envío automático.
  waPhoneNumberId       String     @default("")
  /// Máximo de WhatsApp automáticos al día desde este número.
  waDailyLimit          Int        @default(20)
  /// Logo, foto o firma diseñada. Se aloja en /api/firma/:id, nunca se adjunta.
  signatureImage        Bytes?
  signatureImageType    String?
  signatureImageWidth   Int?
  signatureImageHeight  Int?
  /// DATOS: imagen pequeña con los datos al lado. IMAGEN (y los viejos LOGO y FULL): solo la imagen, nada escrito al lado.
  signatureImageMode    String     @default("IMAGEN")
  /// Sube con cada imagen nueva para que los clientes de correo no usen la vieja en caché.
  signatureImageVersion Int        @default(0)
  /// Máximo de emails al día desde este buzón, sumando todas sus secuencias.
  dailyLimit            Int        @default(50)
  /// Reparto diario: si participa, cuántos contactos nuevos recibe por día y sus dos secuencias (mails y WhatsApp).
  repartoOn             Boolean    @default(false)
  repartoDia            Int        @default(100)
  seqMailId             String?
  seqWaId               String?
  /// Última comprobación de la conexión SMTP (sin enviar nada).
  lastCheckAt           DateTime?
  lastCheckError        String?
  createdAt             DateTime   @default(now())
  sequences             Sequence[]
  /// Clientes de este vendedor.
  clientes              Contact[]  @relation("ClientesDe")
  actividades           Actividad[]
}

/// Registro de lo que hace cada usuario: entradas, búsquedas, mensajes, contactos sumados, importaciones y bloqueos.
model Actividad {
  id        String   @id @default(cuid())
  senderId  String?
  sender    Sender?  @relation(fields: [senderId], references: [id], onDelete: SetNull)
  /// Nombre de quien lo hizo (queda aunque se borre el remitente; «Administrador» si entró con la contraseña).
  quien     String
  /// entro, busqueda, mensaje, mail, whatsapp, secuencia, alta, importo, asigno o bloqueo.
  tipo      String
  texto     String
  contactId String?
  /// Evita registrar dos veces lo mismo (por ejemplo, el mismo mensaje del Radar guardado dos veces).
  ref       String?  @unique
  at        DateTime @default(now())

  @@index([senderId, at])
  @@index([at])
}

/// Base del Radar comercial: documentos JSON por colección (prospectos, busquedas, alertas, pedidos, config),
/// los mismos que usaba el Radar dentro de Claude. `v` sube con cada cambio; los borrados quedan marcados
/// un tiempo para que las pantallas abiertas se enteren.
model RadarDoc {
  col       String
  id        String
  data      Json
  v         Int      @default(1)
  deleted   Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt

  @@id([col, id])
  @@index([updatedAt])
}

/// Ajustes generales de la app (una sola fila, id "app").
model Setting {
  id               String    @id @default("app")
  /// Obsoleto: el encendido ahora es por secuencia (Sequence.sendingOn). Se conserva para no borrar datos.
  sendingEnabled   Boolean   @default(false)
  sendingChangedAt DateTime?
  /// Última pasada del programador y su resultado, para el estado de envío.
  lastRunAt        DateTime?
  lastRun          Json?
  /// Última comprobación SMTP del buzón general (sin enviar nada).
  /// Última lectura de buzones (la Bandeja abierta lee como mucho una vez por minuto).
  lastInboxAt       DateTime?
  generalCheckAt    DateTime?
  generalCheckError String?
  /// Variables del equipo para los mensajes: las propias ({{catalogo}}…), qué escribir si falta un dato y el saludo.
  variables         Json?
  /// Bot de WhatsApp: lo que sabe del negocio y el mensaje que manda cuando no puede responder solo.
  botInfo           String    @default("")
  botSaludo         String    @default("")
  /// Reparto diario de contactos a los remitentes (apagado hasta que el administrador lo encienda) y el último día que corrió.
  repartoOn         Boolean   @default(false)
  repartoUltimo     String    @default("")
}
