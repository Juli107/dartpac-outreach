# Base de datos Postgres (Neon, Supabase, Vercel Postgres o local)
DATABASE_URL="postgresql://usuario:clave@localhost:5432/dartpac"

# Acceso al panel (un solo usuario por ahora)
APP_PASSWORD="cambia-esto"
SESSION_SECRET="cadena-larga-aleatoria"

# Entrar con Google y conectar el Gmail de cada comercial con un clic (opcional).
# Google Cloud > APIs y servicios > Credenciales > ID de cliente OAuth "Aplicación web".
# Pantalla de consentimiento: tipo Interno. URI de redirección: <APP_URL>/api/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Solo las cuentas de este dominio pueden entrar o conectarse
GOOGLE_ALLOWED_DOMAIN="plupackembalajes.com"

# URL pública de la app (para el píxel de apertura y el enlace de baja)
APP_URL="http://localhost:3000"

# Buzón general (SMTP). Se usa en las secuencias sin remitente asignado.
# Los buzones de cada comercial se añaden desde la pantalla Remitentes.
# Con Gmail usa una contraseña de aplicación.
# Buzón general por defecto: julian@ (decidido por Julián el 2026-10-22).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="julian@plupackembalajes.com"
SMTP_PASS=""
MAIL_FROM="Julián Cuello | Plupack Embalajes <julian@plupackembalajes.com>"
# Nombre que aparece en la página de baja
COMPANY_NAME="Plupack Embalajes"

# Lectura de respuestas (IMAP)
IMAP_HOST="imap.gmail.com"
IMAP_PORT="993"
IMAP_USER="julian@plupackembalajes.com"
IMAP_PASS=""

# Clave para cifrar las contraseñas de los remitentes (cadena larga aleatoria; no cambiarla después)
ENCRYPTION_KEY="otra-cadena-larga-aleatoria"

# Protege /api/cron (Vercel lo envía como Bearer automáticamente)
CRON_SECRET="otra-cadena-aleatoria"

# Ventana de envío en hora de España
SEND_HOUR_START="8"
SEND_HOUR_END="19"
SEND_TIMEZONE="America/Argentina/Buenos_Aires"

# Máximo de emails al día desde el buzón general (secuencias sin remitente asignado).
GENERAL_DAILY_LIMIT=50

# Radar comercial: búsqueda de clientes con la API de Claude (console.anthropic.com > API keys).
# Sin la clave, el mapa, las fichas y las secuencias funcionan igual, pero no se pueden pedir búsquedas.
ANTHROPIC_API_KEY=""
# Tope de gasto diario de las búsquedas, en dólares
RADAR_DAILY_USD="25"
# Opcionales: modelos y cuántos partidos recorre la búsqueda automática de los lunes
# RADAR_MODEL="claude-sonnet-5-5"
# RADAR_MODEL_QUICK="claude-haiku-5-5"
# RADAR_SEMANAL_DEPS="12"
