# Base de datos Postgres (Neon, Supabase, Vercel Postgres o local)
DATABASE_URL="postgresql://usuario:clave@localhost:5432/dartpac"

# Acceso al panel (un solo usuario por ahora)
APP_PASSWORD="cambia-esto"
SESSION_SECRET="cadena-larga-aleatoria"

# URL pública de la app (para el píxel de apertura y el enlace de baja)
APP_URL="http://localhost:3000"

# Buzón de envío (SMTP). Con Gmail usa una contraseña de aplicación.
# Recomendado: info@ para prospección, así el buzón personal no se expone a rebotes ni bajas.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="info@plupackembalajes.com"
SMTP_PASS=""
MAIL_FROM="Plupack Embalajes <info@plupackembalajes.com>"
# Nombre que aparece en la página de baja
COMPANY_NAME="Plupack Embalajes"

# Lectura de respuestas (IMAP)
IMAP_HOST="imap.gmail.com"
IMAP_PORT="993"
IMAP_USER="info@plupackembalajes.com"
IMAP_PASS=""

# Protege /api/cron (Vercel lo envía como Bearer automáticamente)
CRON_SECRET="otra-cadena-aleatoria"

# Ventana de envío en hora de España
SEND_HOUR_START="8"
SEND_HOUR_END="19"
SEND_TIMEZONE="Europe/Madrid"
